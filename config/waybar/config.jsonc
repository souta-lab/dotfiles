{
    "layer": "top",
    "position": "top",
    "height": 38,
    "spacing": 0,
    "modules-left": [
        "sway/workspaces",
        "sway/mode"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "cpu",
        "memory",
        "disk",
        "temperature",
        "pulseaudio",
        "network",
        "tray"
    ],
    "sway/workspaces": {
        "disable-scroll": false,
        "all-outputs": false,
        "format": "{icon}",
        "format-icons": {
            "1": "一",
            "2": "二",
            "3": "三",
            "4": "四",
            "5": "五",
            "6": "六",
            "7": "七",
            "8": "八",
            "9": "九",
            "urgent": "󰀨",
            "focused": ""
        }
    },
    "sway/mode": {
        "format": " {} "
    },
    "clock": {
        "format": "󰥔 {:%H:%M}",
        "format-alt": "󰃭 {:%Y-%m-%d (%a) %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "cpu": {
        "format": "󰻠 {usage}%",
        "tooltip": true,
        "interval": 5
    },
    "memory": {
        "format": "󰍛 {used:.1f}G",
        "format-alt": "󰍛 {percentage}%",
        "tooltip-format": "Used: {used:.1f}G / {total:.1f}G"
    },
    "disk": {
        "format": "󰋊 {percentage_used}%",
        "path": "/"
    },
    "temperature": {
        "format": "󰔏 {temperatureC}°C",
        "critical-threshold": 80,
        "tooltip": false
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 Muted",
        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󰋎",
            "headset": "󰋎",
            "phone": "󰏲",
            "portable": "󰏲",
            "car": "󰄋",
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },
        "on-click": "pavucontrol"
    },
    "network": {
        "format-wifi": "󰤨 {essid}",
        "format-ethernet": "󰈀 {ipaddr}",
        "format-disconnected": "󰤮 Disconnected",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}"
    },
    "tray": {
        "spacing": 8,
        "reverse-direction": true
    }
}
